# macOS
.DS_Store

# Xcode / Tuist (generated project — Project.swift is the source of truth)
*.xcodeproj
*.xcworkspace
.build/
DerivedData/
Derived/
Tuist/.build/
*.xcuserstate
xcuserdata/

# Local generation overrides (e.g. HERMES_DEFAULT_SERVER_URL baked in at generate time)
*.local.xcconfig

# Swift Package Manager
.swiftpm/

# TestFlight build artifacts (archive / IPA / ExportOptions) — regenerable
build/

# M0 probe artifacts — regenerable, and the captured session.info frame contains
# the local machine's skills/tools inventory + home paths. Keep out of git.
Probe/fixtures/
/tmp/hermes-probe

# Push-notifications publisher infra — kept local, never pushed (per user)
# Gateway = Cloudflare Worker (holds APNs .p8); hermes-push = standalone pip plugin.
gateway/
hermes-push/
